{
  "name": "stackmon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "STACKMON - The Distributed Realm. A creature-collecting, base-building RPG where the creatures are real technologies and their stats are their real trade-offs.",
  "workspaces": [
    "packages/util",
    "packages/engine",
    "packages/core",
    "packages/content",
    "packages/game",
    "packages/tools"
  ],
  "scripts": {
    "dev": "npm run dev -w @stackmon/game",
    "build": "npm run build -w @stackmon/util && npm run build -w @stackmon/engine && npm run build -w @stackmon/core && npm run build -w @stackmon/content && npm run build -w @stackmon/game",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "preview": "npm run preview -w @stackmon/game",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "assets:fetch": "node packages/tools/src/bake/fetch-kits.mjs",
    "bake": "node packages/tools/src/bake/bake.mjs",
    "bake:preview": "node packages/tools/src/bake/preview.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.5",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "three": "^0.186.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
